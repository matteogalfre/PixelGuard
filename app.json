{
  "expo": {
    "name": "PixelGuard",
    "slug": "pixelguard-mobile",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.matteogalfre.pixelguard",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PixelGuard cherche ton PC sur le Wi-Fi de la maison et y copie tes photos. Rien ne sort de ton réseau.",
        "NSCameraUsageDescription": "PixelGuard lit le code affiché par ton PC pour s'y connecter. Aucune photo n'est prise.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C6CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.matteogalfre.pixelguard",
      "permissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-media-library",
        {
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo",
            "video"
          ],
          "photosPermission": "PixelGuard lit tes photos pour les copier sur ton PC.",
          "savePhotosPermission": "PixelGuard ne crée pas de photo."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "-keep class com.hierynomus.** { *; }\n-keep class net.engio.mbassy.** { *; }\n-keep class expo.modules.pgnative.** { *; }\n-keep class com.journeyapps.barcodescanner.** { *; }\n-keep class com.google.zxing.** { *; }\n-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod\n-dontwarn org.slf4j.**\n-dontwarn org.bouncycastle.**\n-dontwarn net.engio.mbassy.**\n-dontwarn javax.el.**\n-dontwarn org.ietf.jgss.**\n-dontwarn javax.security.auth.kerberos.**\n-dontwarn com.hierynomus.**"
          }
        }
      ],
      "expo-router",
      "expo-image",
      "expo-font",
      "./plugins/with-scene-delegate"
    ],
    "backgroundColor": "#0b1117",
    "scheme": "pixelguard",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47a330a3-7e80-480e-90be-29422feca83c"
      }
    },
    "owner": "matteogalfre"
  }
}
